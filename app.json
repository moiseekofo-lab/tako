{
  "expo": {
    "name": "TaKo Transport",
    "slug": "myApp",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/tako-app-icon.png",
    "scheme": "tako",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moiseekofolab.tako",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#061F68",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.NFC"
      ],
      "package": "com.moiseekofolab.tako"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tako-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#061F68",
          "dark": {
            "backgroundColor": "#061F68"
          }
        }
      ],
      "expo-camera",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser TaKo à utiliser Face ID pour vous connecter à votre compte."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Autoriser TaKo à lire les cartes NFC pour les paiements."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a49b9d7-7f20-4a05-a69c-2c0a1bf0ef52"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4a49b9d7-7f20-4a05-a69c-2c0a1bf0ef52",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
